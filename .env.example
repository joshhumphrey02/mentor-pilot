# Copy to `.env` and adjust. Every value here is optional in local dev: the
# defaults match docker-compose.yml. Never commit a real `.env`.

# --- App -------------------------------------------------------------------
# dev | test | prod. In prod the API docs are disabled, HSTS is sent and CORS is off.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# postgres:// and postgresql:// URLs are accepted and switched to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor_pilot
# Used only by `make test`. Tests create and drop tables here, so keep it separate.
TEST_DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor_pilot_test

# --- Redis (optional) ------------------------------------------------------
# When set, rate limits are shared across workers. Otherwise they are in-memory.
# REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# REQUIRED in prod: signs access tokens, CSRF tokens and OAuth state.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
# Where browsers reach the app. Used in emailed links and the Google redirect.
# Dev: the Vite server. Prod: your real https origin.
PUBLIC_BASE_URL=http://localhost:5173
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# EMAIL_VERIFY_TTL_HOURS=48
# PASSWORD_RESET_TTL_MINUTES=60
# Lock an account for LOCKOUT_MINUTES after this many wrong passwords in a row.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# Cookies are Secure in prod and not in dev. Override only for unusual setups.
# COOKIE_SECURE=true

# Sign in with Google (optional; the button is hidden when unset).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the redirect URI: <PUBLIC_BASE_URL>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI --------------------------------------------------------------------
# Which vendor powers the mentor: openai | anthropic | gemini | fake.
# Switching vendor is this one line, plus that vendor's key and model ids
# below. No code changes. `fake` needs no key and gives canned replies, which
# is handy for local development (it is refused in prod).
AI_PROVIDER=openai

# Model ids belong to whichever vendor AI_PROVIDER names. They are never
# hard-coded, so set them here to that vendor's current recommended models:
#
#   anthropic  AI_MODEL=claude-opus-5-5   AI_FAST_MODEL=claude-haiku-5-5
#              (claude-sonnet-5-5 is a cheaper main model)
#              https://docs.anthropic.com/en/docs/about-claude/models
#   openai     see https://platform.openai.com/docs/models
#   gemini     see https://ai.google.dev/gemini-api/docs/models
#
# AI_MODEL runs the conversation. AI_FAST_MODEL is a cheaper model used for
# titles, summaries and classification (it falls back to AI_MODEL if unset).
AI_MODEL=
AI_FAST_MODEL=
# Pin individual tasks to other models, as JSON. Tasks: chat, title, summary,
# classify, moderation.
# AI_TASK_MODELS={"summary":"some-model-id"}

# Only the key for the active provider is required.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# AI_TEMPERATURE=0.7          # ignored by models that only accept their default
# AI_MAX_OUTPUT_TOKENS=4096
# AI_REQUEST_TIMEOUT_SECONDS=120
# Attempts per request (including the first) on rate limits and server errors.
# AI_MAX_ATTEMPTS=3

# Moderation. OpenAI uses its moderation endpoint; the other providers ask
# AI_FAST_MODEL to classify the text.
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# If the moderation check itself fails, block the message (true) or let it
# through unchecked (false). Keep true: the users are minors.
# MODERATION_FAIL_CLOSED=true

# Cost tracking uses backend/app/ai/pricing.yaml (USD per million tokens). Only
# Anthropic prices ship filled in. Add your models there, or set both of these
# to price AI_MODEL and AI_FAST_MODEL directly. Unpriced models are still
# tracked by token count.
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Lets the mentor show educational videos (YouTube Data API v3 key). Optional:
# without it the mentor has no video search, and everything else works.
# YOUTUBE_API_KEY=
# Sent in the User-Agent of requests to Wikimedia Commons (photo search), whose
# API policy asks for a contact address. No key is needed for photos.
# CONTACT_EMAIL=you@example.com

# --- Usage ------------------------------------------------------------------
# Mentor replies each learner gets free per calendar month. Shown to the
# learner; not enforced until payments exist.
# FREE_TURNS_PER_MONTH=200

# --- Uploads ----------------------------------------------------------------
# Where learners' photos are stored in dev, and the size limit.
# UPLOAD_DIR=backend/uploads
# MAX_UPLOAD_BYTES=5242880

# --- Rate limits (slowapi syntax, per IP address) ---------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_EMAIL=5/hour
# RATE_LIMIT_DEFAULT=120/minute

# --- Email -----------------------------------------------------------------
# With no SMTP_HOST, emails are printed to the backend console in dev (click the
# links from there) and are not sent at all in prod.
#
# New accounts must confirm their email address only when SMTP_HOST is set.
# Without an email server they are confirmed as they are created, which means
# anyone can sign up with an address they do not own. Set this to force it
# either way.
# EMAIL_VERIFICATION=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_FROM=Mentor Pilot <no-reply@example.com>

# --- Dev only --------------------------------------------------------------
# Origins allowed by CORS in dev, as a JSON list. Ignored in prod (same origin).
# CORS_ORIGINS=["http://localhost:5173"]
# Where the Vite dev server proxies /api. Read by frontend/vite.config.ts.
# VITE_API_TARGET=http://localhost:8000
# Host port for the docker-compose Postgres, if 5432 is already taken.
# POSTGRES_PORT=5432
