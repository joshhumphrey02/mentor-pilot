# Copy to `.env` and adjust. Every value here is optional in local dev: the
# defaults match docker-compose.yml. Never commit a real `.env`.

# --- App -------------------------------------------------------------------
# dev | test | prod. In prod the API docs are disabled, HSTS is sent and CORS is off.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# postgres:// and postgresql:// URLs are accepted and switched to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor_pilot
# Used only by `make test`. Tests create and drop tables here, so keep it separate.
TEST_DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor_pilot_test

# --- Redis (optional) ------------------------------------------------------
# When set, rate limits are shared across workers. Otherwise they are in-memory.
# REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# REQUIRED in prod: signs access tokens, CSRF tokens and OAuth state.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
# Where browsers reach the app. Used in emailed links and the Google redirect.
# Dev: the Vite server. Prod: your real https origin.
PUBLIC_BASE_URL=http://localhost:5173
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# EMAIL_VERIFY_TTL_HOURS=48
# PASSWORD_RESET_TTL_MINUTES=60
# Lock an account for LOCKOUT_MINUTES after this many wrong passwords in a row.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# Cookies are Secure in prod and not in dev. Override only for unusual setups.
# COOKIE_SECURE=true

# Sign in with Google (optional; the button is hidden when unset).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the redirect URI: <PUBLIC_BASE_URL>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Rate limits (slowapi syntax, per IP address) ---------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_EMAIL=5/hour
# RATE_LIMIT_DEFAULT=120/minute

# --- Email -----------------------------------------------------------------
# With no SMTP_HOST, emails are printed to the backend console in dev (click the
# links from there) and are not sent at all in prod.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_FROM=Mentor Pilot <no-reply@example.com>

# --- Dev only --------------------------------------------------------------
# Origins allowed by CORS in dev, as a JSON list. Ignored in prod (same origin).
# CORS_ORIGINS=["http://localhost:5173"]
# Where the Vite dev server proxies /api. Read by frontend/vite.config.ts.
# VITE_API_TARGET=http://localhost:8000
# Host port for the docker-compose Postgres, if 5432 is already taken.
# POSTGRES_PORT=5432
