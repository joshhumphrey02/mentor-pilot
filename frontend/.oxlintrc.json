{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "ignorePatterns": ["src/routeTree.gen.ts", "src/lib/api/schema.d.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // role="status" on a <p> is a valid live region; <output> is meant for form results.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      // Route files export a `Route` object next to their component, and
      // shadcn components export their variant helpers; both are by design.
      "files": ["src/routes/**", "src/components/ui/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
