frontend/dist/

# Generated from the backend on demand (`make api-types`); the .d.ts is committed
frontend/openapi.json

# Local uploads (dev attachment storage)
backend/uploads/

# OS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
